# Postgres (Neon en producción; local: postgres://usuario@localhost:5432/vinales)
DATABASE_URL=

# Vercel Blob para subir imágenes desde /admin.
# Sin token, en desarrollo las imágenes se guardan en public/uploads.
BLOB_READ_WRITE_TOKEN=

# Login del panel /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión del admin (cadena larga y aleatoria)
SESSION_SECRET=

# URL pública del sitio (para Open Graph, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://vinales-cigars.com
